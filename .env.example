# Example environment variables for LeadsGenerationAgent
# Copy this file to `.env` and fill in real values before running.

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Groq / LLM
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=gpt-4o-mini
GROQ_LIGHT_MODEL=gpt-4o-light

# Headless browser (True/False)
HEADLESS=False
BROWSER=chromium
# Output directory for exported data
OUTPUT_DIR=output
